{
  "name": "protask",
  "version": "1.0.0",
  "description": "A themeable, effects-rich task manager for Windows, macOS, and Linux",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "dist": "electron-builder --publish=never"
  },
  "keywords": [
    "electron",
    "task-manager",
    "productivity",
    "windows",
    "macos",
    "linux"
  ],
  "author": "Toolzie <hey@toolzie.ca>",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "systeminformation": "^5.33.5"
  },
  "devDependencies": {
    "electron-builder": "^25.1.7",
    "electron": "^44.0.0"
  },
  "build": {
    "appId": "ca.toolzie.protask",
    "productName": "ProTask",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "publisherName": "Toolzie"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ProTask"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "maintainer": "Toolzie <hey@toolzie.ca>",
      "vendor": "Toolzie",
      "synopsis": "Themeable, effects-rich task manager",
      "description": "A free, themeable, effects-rich task manager for desktop."
    },
    "publish": {
      "provider": "github",
      "owner": "daddytroop",
      "repo": "ProTask",
      "releaseType": "release"
    }
  }
}